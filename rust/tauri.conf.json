{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Indiren",
  "identifier": "com.videoindiren.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "Video İndiren",
        "width": 720,
        "height": 880,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#17171a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' https: data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
