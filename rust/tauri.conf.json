{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Indiren",
  "version": "1.0.0",
  "identifier": "com.videoindiren.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Video İndiren",
        "width": 680,
        "height": 820,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#0f0f13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
